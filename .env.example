# DerekOS Master Brain operator configuration (documentation only).
# Runtime reads the process environment; this file is not loaded implicitly.

# Private canonical JSONL store; intentionally absent from a clean mirror.
MASTER_BRAIN_CANONICAL_STORE_PATH=10_CANONICAL_KNOWLEDGE/canonical_records.jsonl

# Governed append-only runtime queues/logs.
MASTER_BRAIN_CANDIDATE_QUEUE_PATH=12_CONFLICTS/candidate_queue.jsonl
MASTER_BRAIN_REVIEW_LOG_PATH=12_CONFLICTS/review_log.jsonl

# Operator-supplied Obsidian vault root. Managed writes stay under MasterBrain/Published.
OBSIDIAN_VAULT_PATH=/path/to/private/obsidian-vault
