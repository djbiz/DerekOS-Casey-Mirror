{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://derekos.master-brain/schemas/relationship.json",
  "title": "Explicit Relationship",
  "description": "Conservative relationship extracted only from explicit source text.",
  "type": "object",
  "required": ["id", "source_id", "target_id", "type", "evidence_class", "confidence", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^R[a-f0-9]{12}$"},
    "source_id": {"type": "string"},
    "target_id": {"type": "string"},
    "type": {"type": "string", "enum": ["related_to", "builds_on", "supersedes", "contradicts", "depends_on", "part_of", "inspired_by", "evolved_into"]},
    "evidence_class": {"type": "string", "enum": ["D0", "D1", "A0", "I0", "E0", "B0", "X0"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "required": ["source_record_id", "file", "conversation_id", "message_id", "original_text"],
      "properties": {
        "source_record_id": {"type": "string"},
        "file": {"type": "string"},
        "conversation_id": {"type": "string"},
        "message_id": {"type": "string"},
        "timestamp": {"type": ["string", "null"]},
        "original_text": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
