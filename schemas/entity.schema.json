{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://derekos.master-brain/schemas/entity.json",
  "title": "Entity",
  "description": "Person, organization, or place identified in the conversation archive.",
  "type": "object",
  "required": ["id", "name", "type", "evidence_class", "confidence", "first_seen", "last_seen"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E[0-9]{7}$"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["person", "organization", "place", "product", "technology"]
    },
    "role": {
      "type": "string",
      "enum": ["primary_subject", "mentioned", "collaborator", "competitor", "inspiration"]
    },
    "evidence_class": {
      "type": "string",
      "enum": ["D0", "D1", "A0", "I0", "E0", "B0", "X0"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "first_seen": {
      "type": "object",
      "required": ["file", "conversation_id", "timestamp"],
      "properties": {
        "file": { "type": "string" },
        "conversation_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "last_seen": {
      "type": "object",
      "required": ["file", "conversation_id", "timestamp"],
      "properties": {
        "file": { "type": "string" },
        "conversation_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "mention_count": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "related_thoughts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_entities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
